# Base de datos Postgres (Neon, vinculada via Vercel).
# En local se genera con `vercel env pull .env.local` y no va en este archivo.
# DATABASE_URL="postgresql://..."
# DATABASE_URL_UNPOOLED="postgresql://..."

# Datos del bono solidario
RAFFLE_TITLE="Bono Solidario PolioPlus - Distrito Rotary 4921"
RAFFLE_TOTAL_TICKETS=1000
RAFFLE_TICKET_PRICE_ARS=10000
RAFFLE_DRAW_DATE="2026-09-30"
RAFFLE_HOLD_MINUTES=4320

# Datos de la cuenta bancaria de Rotary para la transferencia
RAFFLE_BANK_HOLDER="Rotary Club Distrito 4921"
RAFFLE_BANK_ALIAS="ALIAS.A.DEFINIR"
RAFFLE_BANK_CBU="0000000000000000000000"

# Impacto en vacunas: tipo de cambio de referencia (actualizar a mano
# cada tanto) y si el dinero va al PolioPlus Fund oficial (match 2 a 1
# de la Fundacion Gates = multiplicador 3). Poner en 1 si deja de aplicar.
RAFFLE_USD_ARS_RATE=1515
RAFFLE_GATES_MATCH_MULTIPLIER=3

# Email de confirmacion (Resend - https://resend.com)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Bono Solidario PolioPlus <bono@tu-dominio.org>"

# Mercado Pago (se completa mas adelante, cuando el subcomite tenga la cuenta lista)
MP_ACCESS_TOKEN=""

# Secreto simple para confirmar pagos a mano mientras no esta Mercado Pago conectado
ADMIN_SECRET="cambiar-esto"

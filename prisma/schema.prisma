generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  DISPONIBLE
  RESERVADO
  VENDIDO
}

enum OrderStatus {
  PENDIENTE
  PAGADO
  EXPIRADO
  CANCELADO
}

model Ticket {
  id         Int          @id @default(autoincrement())
  number     Int          @unique
  status     TicketStatus @default(DISPONIBLE)
  orderId    Int?
  order      Order?       @relation(fields: [orderId], references: [id])
  reservedAt DateTime?

  @@index([status])
  @@index([orderId])
}

model Order {
  id               Int         @id @default(autoincrement())
  buyerName        String
  buyerEmail       String
  buyerPhone       String
  buyerCuit        String
  buyerClub        String?
  ticketCount      Int
  totalAmount      Int
  status           OrderStatus @default(PENDIENTE)
  paymentRef       String?
  receiptImage     Bytes
  receiptMimeType  String
  // Huella SHA-256 de la imagen del comprobante. Sirve para avisarle al
  // subcomite cuando dos ordenes suben exactamente el mismo archivo, que
  // es la forma mas comun de intentar pagar dos bonos con una sola
  // transferencia. Nullable por las ordenes anteriores a esta columna.
  receiptHash      String?
  createdAt        DateTime    @default(now())
  // Se sigue guardando como referencia de cuando se hizo la reserva, pero
  // ya no vence sola: una reserva solo se libera si un admin la da de baja.
  expiresAt        DateTime
  // Cuando un admin marca que ya le aviso al comprador que el pago entro.
  // Es un checklist manual: el aviso se manda por WhatsApp a mano.
  confirmationSentAt DateTime?
  tickets          Ticket[]

  @@index([receiptHash])
}

/// Interruptores que el subcomite prende y apaga desde el panel. Van a la
/// base y no a variables de entorno para que el cambio sea inmediato y no
/// dependa de un deploy.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Datos del club tomados del padron de autoridades del distrito.
/// La clave es el nombre tal cual figura en DISTRICT_CLUBS: es el mismo
/// texto que guardan las ordenes, asi que cruza sin traducciones.
model ClubDatos {
  club         String         @id
  numeroRotary String?
  diaReunion   String?
  emailClub    String?
  contactos    ClubContacto[]
}

/// Una autoridad del club. Son varias por club (presidente, secretario,
/// tesorero) y por eso van en su propia tabla y no en columnas.
model ClubContacto {
  id        Int       @id @default(autoincrement())
  club      String
  cargo     String
  nombre    String
  periodo   String?
  email     String?
  telefono  String?
  /// Cuando un admin marco que ya le mando el material de difusion.
  avisadoAt DateTime?
  datos     ClubDatos @relation(fields: [club], references: [club], onDelete: Cascade)

  @@index([club])
}
